# Copia este archivo como .env en el servidor. No publiques el archivo .env real.
NODE_ENV=development
PORT=3000
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Recomendado para redes móviles. Guarda ambos valores únicamente en el backend/Render.
# METERED_TURN_APP_NAME=nombre-de-tu-app-metered
# METERED_TURN_API_KEY=clave-de-la-credencial-turn

# Recomendado: secreto compartido de coturn/Metered para credenciales de una hora.
TURN_URLS=turn:your-turn.example.com:3478,turns:your-turn.example.com:5349
TURN_SHARED_SECRET=replace-with-a-long-random-server-secret

# Solo desarrollo local; produccion rechaza credenciales TURN estaticas.
# TURN_USERNAME=development-only
# TURN_CREDENTIAL=development-only
